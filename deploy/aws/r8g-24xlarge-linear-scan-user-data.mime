MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="IRIS_MPC_LINEAR_SCAN"

--IRIS_MPC_LINEAR_SCAN
Content-Type: text/x-shellscript; charset="us-ascii"

#!/usr/bin/env bash
set -euo pipefail

# Keep ENA queue interrupts on the 11 CPUs reserved for Tokio/TLS by banning
# the dot-product CPUs from irqbalance. This is the persistent equivalent of
# scripts/tools/pin-network-irqs.sh and measured ~9% faster on r8g.24xlarge.
if ! command -v irqbalance >/dev/null 2>&1; then
    if command -v dnf >/dev/null 2>&1; then
        dnf install -y irqbalance
    else
        apt-get update
        apt-get install -y irqbalance
    fi
fi

install -d -m 0755 /etc/systemd/system/irqbalance.service.d
printf '%s\n' \
    '[Service]' \
    'Environment="IRQBALANCE_BANNED_CPULIST=11-95"' \
    > /etc/systemd/system/irqbalance.service.d/iris-mpc-linear-scan.conf

systemctl daemon-reload
systemctl enable --now irqbalance
systemctl restart irqbalance

--IRIS_MPC_LINEAR_SCAN--
